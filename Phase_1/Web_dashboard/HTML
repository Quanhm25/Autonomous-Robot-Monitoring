<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8">
    <title>Autonomous Robot Monitoring</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <h1>Robot Controller System - Phase 1</h1>
    
    <div class="controller">
     <h3 class="cochupaneltitle panel-title">Khu vực điều khiển</h3>

     <!-- Khu vực nút điều hướng -->
     <button id="btn-forward" class="directional_btn arrow">&#8593</button>
     <div class="middle_row">
      <button id="btn-left" class="directional_btn arrow">&#8592</button>
      <button id="btn-stop" class="stop_btn">Stop</button>
      <button id="btn-right" class="directional_btn arrow">&#8594</button>
     </div>
     <button id="btn-backward" class="directional_btn arrow">&#8595</button>

    </div>

    <script src="script.js"></script>

  </body>
</html>
