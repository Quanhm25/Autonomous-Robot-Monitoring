body {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-family: Arial, sans-serif;
  background-color: #ffffff;
  margin-top: 40px;
}

h1 {
  margin-bottom:  10px;
}

.thuoctinhtacgia {
  font-weight: 300;
  font-style: italic;
  margin-top: 0px;
  margin-bottom: 50px;
}

.cochupaneltitle {
  font-size: 25px;
}

.controller {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  border: 2px solid black;
  border-radius: 12px;
  padding: 30px 40px;
}

.panel-title {
  margin: 0 0 15px 0;
  padding-bottom: 10px;
  width: 80%;
  text-align: center;
  border-bottom: 2px solid #000000;
}

.middle_row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  width: 300px;
}

.directional_btn {
  width: 90px;
  padding: 30px 0;
  font-size: 20px;
  font-weight: bold;
  color: white;
  background-color: #5181e8;
  border: none;
  border-radius: 10px;
  cursor: pointer;
}

.arrow {
  font-size: 25px;
}

.stop_btn {
  width: 90px;
  padding: 30px 0;
  font-size: 20px;
  font-weight: bold;
  color: white;
  background-color: #5181e8;
  border: none;
  border-radius: 10px;
  cursor: pointer;
}

.directional_btn:hover {
  background-color: #2bec9c;
}
.directional_btn:active {
  background-color: #29af77;
}

.stop_btn:hover {
  background-color: #2bec9c;
}
.stop_btn:active {
  background-color: #ff0404;
}
